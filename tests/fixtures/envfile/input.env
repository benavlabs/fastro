# ===================================
# App
# ===================================
APP_NAME=mini

# ===================================
# Cache
# ===================================
# @fastro if=cache
# Options: memory, redis
# @fastro option=cache.backend
CACHE_BACKEND=memory
# @fastro option=cache.backend
CACHE_URL=memory://localhost
# @fastro option=cache.backend
CACHE_KEY=memory

# ===================================
# Redis
# ===================================
# @fastro if=cache.backend=redis
REDIS_HOST=localhost

# ===================================
# Billing
# ===================================
# @fastro if=billing and not admin
# @fastro option=billing.provider
BILLING_PROVIDER=stripe

# ===================================
# Logging
# ===================================
LOG_LEVEL=info
